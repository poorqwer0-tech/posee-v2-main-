<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd — auto-start POS บน macOS
  ติดตั้ง:
    แก้ path ให้ตรงเครื่อง (WorkingDirectory + program args)
    cp scripts/com.pos.server.plist.example ~/Library/LaunchAgents/com.pos.server.plist
    launchctl load ~/Library/LaunchAgents/com.pos.server.plist
  หยุด:  launchctl unload ~/Library/LaunchAgents/com.pos.server.plist
  log:   /tmp/pos.out / /tmp/pos.err
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.pos.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/CHANGE_ME/pos/scripts/start-local.sh</string>
  </array>
  <key>WorkingDirectory</key>   <string>/Users/CHANGE_ME/pos</string>
  <key>RunAtLoad</key>          <true/>
  <key>KeepAlive</key>          <true/>
  <key>StandardOutPath</key>    <string>/tmp/pos.out</string>
  <key>StandardErrorPath</key>  <string>/tmp/pos.err</string>
</dict>
</plist>
